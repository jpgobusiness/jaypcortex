# Copie para .env (gitignored). Nunca commite senhas.

# sqlite | postgres  (após o corte: postgres)
DATABASE_PROVIDER=postgres

# Backup SQLite local (não é mais o banco do app depois do corte).
DATABASE_URL="file:./dev.db"

# Postgres direto (migrations). Painel Supabase → Database → URI (direct).
POSTGRES_DATABASE_URL=

# Pooler (app na Vercel). Painel Supabase → Database → URI (transaction pooler).
POSTGRES_POOLER_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# ou a anon key clássica (eyJ...), se a publishable tomar 401
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só servidor. Nunca no client.
SUPABASE_SECRET_KEY=

# E-mail do admin (seed da etapa 3). Senha NÃO entra aqui nem no git.
ADMIN_EMAIL=

# Embeddings (opcional). Sem isso, a busca cai para FTS.
OPENAI_API_KEY=
EMBEDDINGS_PROVIDER=openai

# Fuso das datas civis ("hoje", briefing).
APP_TIMEZONE=America/Sao_Paulo

# MCP
MCP_ENABLED=true
MCP_BOOTSTRAP_TOKEN=
