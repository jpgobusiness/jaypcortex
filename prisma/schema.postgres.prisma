// Schema Postgres (Supabase). Espelho 1:1 do SQLite, IDs cuid em text.
// OvertimeAttachment usa `path` (Storage), sem BYTEA.
// O app local continua no schema sqlite até o corte (DATABASE_PROVIDER=sqlite).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma-postgres"
}

datasource db {
  provider = "postgresql"
}

/// Estágios do funil (pipeline). Configuráveis pelo usuário.
model Stage {
  id            String        @id @default(cuid())
  name          String
  order         Int           @default(0)
  color         String        @default("#6366f1")
  probability   Int           @default(0) // probabilidade padrão de fechamento (%)
  isWon         Boolean       @default(false) // conta como receita realizada (ganho)
  isLost        Boolean       @default(false) // negócio perdido
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  opportunities Opportunity[]

  @@index([order])
}

/// Oportunidade (negócio) que avança pelo pipeline.
model Opportunity {
  id            String     @id @default(cuid())
  name          String
  client        String? // empresa / cliente
  contact       String? // nome do contato
  email         String?
  phone         String?
  value         Float      @default(0) // valor do negócio (R$)
  probability   Int? // override da probabilidade do estágio (%)
  stageId       String
  stage         Stage      @relation(fields: [stageId], references: [id])
  commercialId  String? // comercial responsável pela oportunidade
  commercial    Commercial? @relation(fields: [commercialId], references: [id])
  quarter       String? // Q1, Q2, Q3, Q4
  year          Int?
  expectedClose DateTime? // data prevista de fechamento
  closedAt      DateTime? // data real de fechamento
  owner         String? // responsável
  source        String? // origem do lead
  description   String?

  // Campos comerciais
  monthlyValue   Float   @default(0) // valor mensal (recorrência)
  setupValue     Float   @default(0) // valor de setup (pontual)
  contractMonths Int? // tempo do contrato (em meses)
  product        String? // produto
  subOffer       String? // suboferta
  recurrenceType String? // RECORRENTE | SETUP | PONTUAL

  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  activities Activity[]

  @@index([stageId])
  @@index([commercialId])
  @@index([quarter, year])
}

/// Comercial (vendedor) que está tocando a oportunidade. Configurável.
model Commercial {
  id            String        @id @default(cuid())
  name          String
  color         String        @default("#6366f1")
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  opportunities Opportunity[]
}

/// Status de atividade configurável (renomear, criar, excluir).
/// A chave (key) é o valor estável referenciado por Activity.status.
model ActivityStatus {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  color     String   @default("#6366f1")
  order     Int      @default(0)
  isDone    Boolean  @default(false) // marca conclusão (para completedAt, dashboard, checkbox)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// Tipos de atividade configuráveis (ex.: Criar Doc, Criar Proposta, Criar Calculadora).
model ActivityType {
  id         String     @id @default(cuid())
  name       String
  color      String     @default("#6366f1")
  createdAt  DateTime   @default(now())
  activities Activity[]
}

/// Atividade/tarefa, opcionalmente vinculada a uma oportunidade.
model Activity {
  id            String        @id @default(cuid())
  title         String
  typeId        String?
  type          ActivityType? @relation(fields: [typeId], references: [id])
  opportunityId String?
  opportunity   Opportunity?  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  status        String        @default("pending") // pending | in_progress | done
  priority      String        @default("normal") // low | normal | high | urgent
  dueDate       DateTime?
  notes         String?
  completedAt   DateTime?
  queueOrder    Int? // posição na fila de prioridades (null = fora da fila)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  mapNodes      ActivityMapNode[]

  @@index([opportunityId])
  @@index([status])
  @@index([queueOrder])
}

/// Contato disponível para fluxos de automação, como envio de mensagens pelo WhatsApp.
model AutomationContact {
  id            String   @id @default(cuid())
  automationKey String   @default("whatsapp_message")
  name          String
  phone         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([automationKey, phone])
  @@index([automationKey, name])
}

/// Pasta de mapas mentais.
model MindMapGroup {
  id        String    @id @default(cuid())
  name      String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  maps      MindMap[]

  @@index([order])
}

/// Um quadro de mapa mental. Vários mapas, cada um com seus cartões e setas.
model MindMap {
  id        String            @id @default(cuid())
  name      String
  groupId   String?
  group     MindMapGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  nodes     ActivityMapNode[]
  shapes    MindMapShape[]
  connections MindMapConnection[]

  @@index([groupId, order])
}

/// Posição de uma atividade em um mapa mental.
model ActivityMapNode {
  id         String   @id @default(cuid())
  mapId      String
  map        MindMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  x          Float    @default(0)
  y          Float    @default(0)
  color      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([mapId, activityId])
  @@index([mapId])
}

/// Forma livre posicionada dentro de um mapa mental.
model MindMapShape {
  id        String   @id @default(cuid())
  mapId     String
  map       MindMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  kind      String   @default("rectangle")
  label     String?
  iconName  String?
  x         Float    @default(0)
  y         Float    @default(0)
  width     Float    @default(160)
  height    Float    @default(90)
  color     String   @default("#dbeafe")
  zIndex    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mapId])
}

/// Ligação genérica entre atividades e/ou formas do mesmo mapa.
model MindMapConnection {
  id        String   @id @default(cuid())
  mapId     String
  map       MindMap  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  fromType  String
  fromId    String
  fromSide  String   @default("right")
  toType    String
  toId      String
  toSide    String   @default("left")
  createdAt DateTime @default(now())

  @@unique([mapId, fromType, fromId, toType, toId])
  @@index([mapId])
  @@index([fromType, fromId])
  @@index([toType, toId])
}

/// Item configurável do desafio (ex.: Água, Chá, Treino, Cerveja...).
model ChallengeItem {
  id        String   @id @default(cuid())
  name      String // nome exibido ("Água 3L", "Treino", etc.)
  icon      String   @default("circle") // nome do ícone Lucide
  order     Int      @default(0) // ordem na tabela
  active    Boolean  @default(true) // se false, não conta na pontuação
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  checks    ChallengeDayCheck[]

  @@index([order])
}

/// Desafio mensal (hábitos do dia). Um registro por dia civil dentro do mês.
model ChallengeDay {
  id            String   @id @default(cuid())
  monthKey      String // "YYYY-MM"
  day           Int // 1–28/29/30/31 conforme o mês
  date          DateTime // meia-noite UTC do dia
  water         Boolean  @default(false) // Água 3L-4L
  tea           Boolean  @default(false) // Chá de Cavalinha 1L
  breakfast     Boolean  @default(false) // Café da Manhã
  lunch         Boolean  @default(false) // Almoço
  snack         Boolean  @default(false) // Lanche
  dinner        Boolean  @default(false) // Jantar
  drankBeer     Boolean  @default(false) // legado: true = bebeu
  beerAbstained Boolean  @default(false) // marcou que não bebeu
  beerCans      Int      @default(0) // legado (não usado na UI)
  workoutStatus String   @default("not_done") // done | rest | not_done | double
  workoutType   String? // treino_a | treino_b | treino_c | treino_d | corrida | descanso
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  checks        ChallengeDayCheck[]

  @@unique([monthKey, day])
  @@index([monthKey])
}

/// Check de um item em um dia específico (pivot ChallengeDay ↔ ChallengeItem).
model ChallengeDayCheck {
  id        String        @id @default(cuid())
  dayId     String
  day       ChallengeDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  itemId    String
  item      ChallengeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  checked   Boolean       @default(true)
  createdAt DateTime      @default(now())

  @@unique([dayId, itemId])
  @@index([dayId])
  @@index([itemId])
}

/// Configuração do desafio por mês (meta de nota, etc.).
model ChallengeMonth {
  id        String   @id @default(cuid())
  monthKey  String   @unique // "YYYY-MM"
  goalScore Float    @default(70) // meta de nota do mês (%)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Mês de controle de horas extras. Valor-hora e meta configuráveis por mês.
model OvertimeMonth {
  id         String          @id @default(cuid())
  monthKey   String          @unique // formato "YYYY-MM"
  hourlyRate Float           @default(0) // valor da hora extra (R$)
  goalHours  Float           @default(0) // meta de horas do mês
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  entries    OvertimeEntry[]
}

/// Registro de hora extra dentro de um mês.
model OvertimeEntry {
  id               String               @id @default(cuid())
  monthId          String
  month            OvertimeMonth        @relation(fields: [monthId], references: [id], onDelete: Cascade)
  date             DateTime
  hours            Float                @default(0)
  description      String?
  clickupRequested Boolean              @default(false) // validado e solicitado no ClickUp
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  attachments      OvertimeAttachment[]

  @@index([monthId])
}

/// Arquivo/imagem anexado a um registro de hora extra (arquivo no Storage).
/// `path` é o caminho no bucket privado overtime-attachments. Sem BYTEA.
model OvertimeAttachment {
  id        String        @id @default(cuid())
  entryId   String
  entry     OvertimeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  name      String
  mimeType  String
  size      Int
  path      String
  createdAt DateTime      @default(now())

  @@index([entryId])
}

/// Meta por quarter. A meta acumulada é calculada somando os quarters anteriores.
model QuarterGoal {
  id        String   @id @default(cuid())
  year      Int
  quarter   String // Q1, Q2, Q3, Q4
  target    Float // meta do quarter (não acumulada)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, quarter])
}

/// Hábito recorrente do Controle Diário (dinâmico — o usuário pode criar/editar/excluir).
model DailyHabit {
  id        String            @id @default(cuid())
  name      String
  order     Int               @default(0)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  checks    DailyHabitCheck[]

  @@index([order])
  @@index([active])
}

/// Dia do Controle Diário (um por data civil).
model DailyDay {
  id        String            @id @default(cuid())
  date      DateTime          @unique // meia-noite UTC do dia (YYYY-MM-DD)
  day       Int // 1–31
  monthKey  String // "YYYY-MM"
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  checks    DailyHabitCheck[]

  @@index([monthKey])
}

/// Checkbox de um hábito em um dia específico.
model DailyHabitCheck {
  id      String     @id @default(cuid())
  dayId   String
  day     DailyDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  habitId String
  habit   DailyHabit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  done    Boolean    @default(false)

  @@unique([dayId, habitId])
  @@index([habitId])
}

/// Espaço de trabalho. Aparece no menu e agrupa pastas e arquivos.
model Workspace {
  id          String            @id @default(cuid())
  name        String
  description String?
  color       String            @default("#7b68ee")
  order       Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  folders     WorkspaceFolder[]
  files       WorkspaceFile[]
  agent       Agent? // preenchido quando o espaço é a sala de um agente

  @@index([order])
}

/// Pasta de um espaço, para separar arquivos.
model WorkspaceFolder {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  files       WorkspaceFile[]

  @@index([workspaceId, order])
}

/// Arquivo (página de conteúdo) de um espaço, solto ou dentro de uma pasta.
model WorkspaceFile {
  id           String           @id @default(cuid())
  workspaceId  String
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folderId     String?
  folder       WorkspaceFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  title        String           @default("Sem título")
  content      String           @default("") // documento do editor em JSON (TipTap)
  excerpt      String           @default("") // início do texto, para prévias no dashboard
  order        Int              @default(0)
  kind         String           @default("contexto")
  tags         String[]         @default([])
  searchText   String           @default("")
  contentHash  String?
  indexedAt    DateTime?
  indexStatus  String           @default("pending")
  updatedBy    String?          @db.Uuid
  source       String           @default("ui")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  knowledge    AgentKnowledge[]
  chunks       KnowledgeChunk[]
  promptLayers AgentPromptLayer[]
  revisions    FileRevision[]

  @@index([workspaceId, folderId, order])
  @@index([folderId])
  @@index([kind])
}

/// Agente de IA do escritório. Um deles é o orquestrador (o "cérebro").
model Agent {
  id                   String              @id @default(cuid())
  name                 String
  slug                 String?             @unique
  role                 String              @default("")
  description          String              @default("")
  instructions         String              @default("")
  isOrchestrator       Boolean             @default(false)
  deskIndex            Int?                @unique
  skinTone             String              @default("#c68a62")
  hairStyle            String              @default("short")
  hairColor            String              @default("#2a1b14")
  shirtColor           String              @default("#4f46e5")
  accessory            String              @default("none")
  workspaceId          String?             @unique
  workspace            Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  model                String              @default("claude-sonnet")
  temperature          Float               @default(0.3)
  status                String               @default("draft")
  activePromptVersionId String?
  retrievalConfig       Json                 @default("{\"topK\":8,\"minScore\":0.25,\"hybridWeight\":0.6,\"kinds\":[]}")
  capabilities          Json                 @default("[]")
  knowledge             AgentKnowledge[]
  promptLayers          AgentPromptLayer[]
  promptVersions        AgentPromptVersion[]
  proposals             ChangeProposal[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

/// Perfil 1:1 com auth.users. Criado pelo trigger; role admin só via seed/gestão.
model Profile {
  id          String    @id @db.Uuid
  email       String    @unique
  displayName String?   @map("display_name")
  role        String    @default("member")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdBy   String?   @map("created_by") @db.Uuid

  @@map("profiles")
}

/// Documento anexado à base de conhecimento de um agente.
model AgentKnowledge {
  id        String        @id @default(cuid())
  agentId   String
  agent     Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fileId    String
  file      WorkspaceFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([agentId, fileId])
  @@index([fileId])
}

/// Trecho indexado (FTS + vetor) de um arquivo.
model KnowledgeChunk {
  id         String        @id @default(cuid())
  fileId     String
  file       WorkspaceFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  chunkIndex Int
  headingPath String       @default("")
  content    String
  tokenCount Int           @default(0)
  embedding  Unsupported("vector")?
  createdAt  DateTime      @default(now())

  @@unique([fileId, chunkIndex])
  @@index([fileId])
}

model AgentPromptLayer {
  id        String        @id @default(cuid())
  agentId   String
  agent     Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  fileId    String
  file      WorkspaceFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  layer     String
  order     Int           @default(0)
  enabled   Boolean       @default(true)

  @@unique([agentId, layer])
  @@index([fileId])
  @@index([agentId, order])
}

model AgentPromptVersion {
  id              String   @id @default(cuid())
  agentId         String
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  version         Int
  composedPrompt  String
  layersSnapshot  Json
  note            String?
  createdBy       String?  @db.Uuid
  source          String   @default("ui")
  createdAt       DateTime @default(now())

  @@unique([agentId, version])
  @@index([agentId])
}

model ChangeProposal {
  id              String    @id @default(cuid())
  agentId         String?
  agent           Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  targetType      String
  targetId        String?
  title           String
  rationale       String    @default("")
  baseHash        String?
  proposedContent Json
  proposedMeta    Json?
  diffText        String    @default("")
  status          String    @default("pending")
  createdBy       String?   @db.Uuid
  source          String    @default("mcp")
  appliedBy       String?   @db.Uuid
  appliedAt       DateTime?
  createdAt       DateTime  @default(now())
  revisions       FileRevision[]

  @@index([agentId, status])
  @@index([status, createdAt])
}

model FileRevision {
  id         String          @id @default(cuid())
  fileId     String
  file       WorkspaceFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  content    String
  title      String
  hash       String
  createdBy  String?         @db.Uuid
  source     String          @default("ui")
  proposalId String?
  proposal   ChangeProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([fileId, createdAt])
  @@index([hash])
}

model McpToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  prefix     String
  scopes     String[]  @default([])
  profileId  String    @db.Uuid
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  audits     AuditLog[]

  @@index([profileId])
}

/// Cliente OAuth 2.0 (client_credentials e/ou authorization_code) para MCP.
model McpOAuthClient {
  id               String                     @id @default(cuid())
  name             String
  clientId         String                     @unique
  clientSecretHash String
  scopes           String[]                   @default([])
  redirectUris     String[]                   @default([])
  publicClient     Boolean                    @default(false)
  grantTypes       String[]                   @default(["client_credentials"])
  revokedAt        DateTime?
  createdAt        DateTime                   @default(now())
  accessTokens     McpOAuthAccessToken[]
  authCodes        McpOAuthAuthorizationCode[]
  refreshTokens    McpOAuthRefreshToken[]
}

/// Access token OAuth (só o hash no banco). Expira em 3600s.
model McpOAuthAccessToken {
  id        String         @id @default(cuid())
  tokenHash String         @unique
  clientId  String
  client    McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  scopes    String[]       @default([])
  profileId String?        @db.Uuid
  grantType String         @default("client_credentials")
  expiresAt DateTime
  createdAt DateTime       @default(now())

  @@index([clientId])
  @@index([expiresAt])
  @@index([profileId])
}

/// Authorization code (hash, 10 min, uso único) + PKCE S256.
model McpOAuthAuthorizationCode {
  id                  String         @id @default(cuid())
  codeHash            String         @unique
  clientId            String
  client              McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  profileId           String         @db.Uuid
  redirectUri         String
  scopes              String[]       @default([])
  codeChallenge       String
  codeChallengeMethod String         @default("S256")
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime       @default(now())

  @@index([clientId])
  @@index([expiresAt])
}

/// Refresh token (hash, 30 dias).
model McpOAuthRefreshToken {
  id        String         @id @default(cuid())
  tokenHash String         @unique
  clientId  String
  client    McpOAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  profileId String         @db.Uuid
  scopes    String[]       @default([])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime       @default(now())

  @@index([clientId])
  @@index([profileId])
  @@index([expiresAt])
}

model AuditLog {
  id        String    @id @default(cuid())
  actorId   String?
  actorType String    @default("user")
  tokenId   String?
  token     McpToken? @relation(fields: [tokenId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  at        DateTime  @default(now())

  @@index([at])
  @@index([entity, entityId])
}
